<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rapid_nav_perception</name>
  <version>0.1.0</version>
  <description>Optical flow for the RAPID-NAV robot: Farnebäck, RAFT and frame-routing (FlowNetS / SEA-RAFT) backends, back-projection, the flow colour picture and the flow node.</description>
  <maintainer email="harsh.v.sharma@outlook.com">Harsh Vardhan</maintainer>
  <license>MIT</license>

  <author>Rishi Atreya</author>
  <author>Kamalesh Kumar B</author>
  <author>Jaspinder Kaur</author>
  <author>Harsh Vardhan</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>rapid_nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
