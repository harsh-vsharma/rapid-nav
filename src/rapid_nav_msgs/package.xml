<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rapid_nav_msgs</name>
  <version>0.1.0</version>
  <description>Messages of the RAPID-NAV perception pipeline: the optical flow frame and the tracked obstacles.</description>
  <maintainer email="harsh.v.sharma@outlook.com">Harsh Vardhan</maintainer>
  <license>MIT</license>

  <author>Rishi Atreya</author>
  <author>Kamalesh Kumar B</author>
  <author>Jaspinder Kaur</author>
  <author>Harsh Vardhan</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
