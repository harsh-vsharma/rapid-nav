<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rapid_nav_tools</name>
  <version>0.1.0</version>
  <description>sim_check and planner_check: commands that check the RAPID-NAV simulation and the global planners and write a bundle; path_viewer shows the planners' paths in RViz.</description>
  <maintainer email="harsh.v.sharma@outlook.com">Harsh Vardhan</maintainer>
  <license>MIT</license>

  <author>Rishi Atreya</author>
  <author>Kamalesh Kumar B</author>
  <author>Jaspinder Kaur</author>
  <author>Harsh Vardhan</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <!-- nav_run reads the scenarios and the map of rapid_nav_navigation at run time. That package
       depends on this one, so it is not listed here. -->

  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rapid_nav_msgs</exec_depend>
  <exec_depend>rapid_nav_perception</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
